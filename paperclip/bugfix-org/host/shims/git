#!/bin/bash
# A stand-in `git` for the bug-fix org's service PATH (CB-478, CB-489); the
# partner of the `gh` beside it. When the org's token is in play
# (BUGFIX_GH_TOKEN or BUGFIX_SPOOL set) and GIT_CONFIG_PARAMETERS is not, it
# gives git the same settings as the skill's export line: the `gh auth
# git-credential` helper (the token reaches gh through GH_TOKEN, never through
# git's arguments or output) and the App's bot as author. GH_TOKEN is chosen
# as the `gh` stand-in chooses it, from the warden's current token file
# (bugfix-token.bash), and a 401 is retried once with a newer one. It runs the
# first real `git` on PATH outside this script's own folder.
# Builtins only for the lookup: the service PATH may not hold dirname.
self_dir=$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)
real=
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ -n "$d" ] || continue
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
  if [ -x "$d/git" ] && [ ! -d "$d/git" ]; then real="$d/git"; break; fi
done
if [ -z "$real" ]; then
  echo "git: real git not found on PATH outside $self_dir" >&2
  exit 127
fi
if [ -z "${BUGFIX_GH_TOKEN:-}" ] && [ -z "${BUGFIX_SPOOL:-}" ]; then
  exec "$real" "$@"
fi
if [ -z "${GIT_CONFIG_PARAMETERS:-}" ]; then
  export GIT_CONFIG_PARAMETERS="'credential.helper=' 'credential.https://github.com.helper=!gh auth git-credential' 'user.name=orbweaver-bugfix[bot]' 'user.email=360784342+orbweaver-bugfix[bot]@users.noreply.github.com'"
fi
if [ ! -r "$self_dir/bugfix-token.bash" ]; then
  [ -n "${GH_TOKEN:-}" ] || [ -z "${BUGFIX_GH_TOKEN:-}" ] || export GH_TOKEN="$BUGFIX_GH_TOKEN"
  exec "$real" "$@"
fi
. "$self_dir/bugfix-token.bash"
bugfix_run_with_retry "$real" "$@"
exit $?
