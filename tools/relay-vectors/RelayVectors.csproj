<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>RelayVectors</AssemblyName>
    <RootNamespace>Orbweaver</RootNamespace>
    <!-- Matches Orbweaver.csproj, which publishes self-contained. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shipped RelayCrypto, referenced rather than copied: the vectors
         are only worth anything if they come out of the code the app runs.
         RelayCrypto is internal, so Orbweaver.csproj grants this assembly
         InternalsVisibleTo alongside the probes. -->
    <ProjectReference Include="../../Orbweaver.csproj" />
  </ItemGroup>

</Project>
