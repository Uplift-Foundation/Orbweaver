<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>RelayProbe</AssemblyName>
    <RootNamespace>Orbweaver</RootNamespace>
    <!-- Matches Orbweaver.csproj, which publishes self-contained. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- CB-314: the shipped RelayClient, referenced rather than reimplemented,
         driven against a real relay as the desktop alongside a scripted
         phone. Internal types, so Orbweaver.csproj grants this assembly
         InternalsVisibleTo, as it does tools/peer-probe. -->
    <ProjectReference Include="../../Orbweaver.csproj" />
  </ItemGroup>

</Project>
