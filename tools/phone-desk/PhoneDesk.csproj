<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>PhoneDesk</AssemblyName>
    <RootNamespace>Orbweaver</RootNamespace>
    <!-- Matches Orbweaver.csproj, which publishes self-contained. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- CB-316: the shipped RelayClient, PhoneService and PhoneLaunch, driven
         against a real relay for a real phone to pair with. Internal types, so
         Orbweaver.csproj grants this assembly InternalsVisibleTo. -->
    <ProjectReference Include="../../Orbweaver.csproj" />
  </ItemGroup>

</Project>
