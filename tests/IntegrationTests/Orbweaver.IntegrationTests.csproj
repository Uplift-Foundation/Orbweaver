<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>Orbweaver.IntegrationTests</AssemblyName>
    <RootNamespace>Orbweaver.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Orbweaver.csproj" />
    <!-- CB-206: a second process to claim the single-instance mutex from. -->
    <ProjectReference Include="..\SingleInstanceProbe\SingleInstanceProbe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CB-278: the unit suite's in-memory gateway socket, so a whole hello-ok
         can be driven through OpenClawGateway here without a second copy of
         it to keep in step. -->
    <Compile Include="..\UnitTests\FakeGatewaySocket.cs" Link="FakeGatewaySocket.cs" />
    <Compile Include="..\TranscriptTests\PaneFixtures.cs" Link="PaneFixtures.cs" />
    <!-- CB-270 Stage 3: the captured native runs, as one scrubbed constant. -->
    <Compile Include="..\UnitTests\OpenClawNativeRunFixture.cs" Link="OpenClawNativeRunFixture.cs" />
    <!-- CB-306: real commands.list and a /status card, as constants. -->
    <Compile Include="..\UnitTests\OpenClawSlashFixtures.cs" Link="OpenClawSlashFixtures.cs" />
    <!-- CB-308: the real GitHub /releases/latest response, served back by UpdateDownloadTests. -->
    <Content Include="..\UnitTests\Fixtures\update\latest.json" Link="Fixtures\update\latest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
