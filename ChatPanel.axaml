<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Orbweaver.ChatPanel"
        x:CompileBindings="False"
        Width="340" Height="420"
        MinWidth="280" MaxWidth="640"
        MinHeight="200" MaxHeight="720"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="True"
        ShowActivated="True"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="Manual">

    <!-- ShowActivated="True" is the deliberate departure from OrbFlyout, which
         is False. The flyout is a hover surface and must never take focus; this
         has a text box in it, so it must. For the same reason nothing here is
         driven by the hover bridge in OrbWindow — a panel that vanished when the
         pointer left would be unusable.

         RequestedThemeVariant is pinned because the macOS theme is per-variant:
         left to the OS appearance it would hand a light TextBox to a dark card.

         The window is user-resizable (CanResize, explicit Width/Height rather
         than SizeToContent) and Root stretches to fill it, unlike OrbWindow's
         pinned width — once a person drags an edge, that size is theirs to
         keep, and new turns scroll inside it rather than growing the window
         out from under their hands. Kept per agent and across runs: the
         Width/Height here are only the size a panel opens at the first time
         an agent is clicked, after which ApplySavedSize replaces them with
         whatever that agent's panel was last dragged to. WindowDecorations
         is still None, so there is no OS-drawn resize border to grab; the
         eight transparent strips after Root exist purely to give
         BeginResizeDrag somewhere to grab.

         Colours are lifted from OrbFlyout.axaml so the two read as one app. -->
    <Grid>
    <Border x:Name="Root"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            CornerRadius="12" Padding="10"
            Background="#E0202024" BorderBrush="#80FFFFFF" BorderThickness="1.5">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="6">

            <!-- A contact card: portrait, then who and where stacked beside
                 it, then the actions. The name and the place used to be one
                 line squeezed next to a 68pt circle, which left the row looking
                 top-heavy and wasted the height the portrait had already spent.
                 Two lines fill it and read faster — the name is what you look
                 for, the place is what you check. -->
            <!-- Named and given a background because it is the drag handle
                 for a pinned panel: WindowDecorations is None, so there is no
                 title bar, and a Grid with no Background is not hit-testable
                 in the gaps between its children. Transparent draws nothing
                 and catches everything, which is exactly a title bar. See the
                 HeaderRow handler in ChatPanel.axaml.cs for why the drag is
                 offered only while pinned. -->
            <Grid x:Name="HeaderRow" Grid.Row="0"
                  Background="Transparent"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Grid x:Name="AvatarBox" Grid.Column="0" Width="68" Height="68"
                      VerticalAlignment="Center" Cursor="Hand"
                      Background="Transparent">
                    <Ellipse x:Name="Avatar" Width="68" Height="68"
                             Stroke="#40FFFFFF" StrokeThickness="1"
                             IsVisible="False"/>
                    <!-- Agents without a picture have an emoji, and it is a
                         better mark than the first letter of their name. -->
                    <TextBlock x:Name="AvatarEmoji"
                               FontSize="38"
                               IsVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <!-- The connection state rides on the portrait as a badge,
                         the way presence dots do everywhere else: green when
                         the conversation is reachable, amber while it is
                         attaching, red when it failed. No extra header width. -->
                    <Ellipse x:Name="StateDot"
                             Width="13" Height="13"
                             Stroke="#FF202024" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Where this conversation is, and what kind of thing it
                         is. The second half is a chip rather than more words in
                         the same line because "general" and "wtvamp" are the
                         same shape as each other, and one of them is a room
                         other people can read. -->
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border x:Name="KindChip"
                                IsVisible="False"
                                CornerRadius="4" Padding="4,1"
                                VerticalAlignment="Center"
                                Background="#26FFFFFF">
                            <!-- The kind's mark is drawn here for the same
                                 reason it is on the orb (see SymbolMarks): as
                                 text, the clock, gear, arrows and cloud fall
                                 back to Segoe UI Emoji on Windows and arrive in
                                 that font's colours instead of the chip's ink.
                                 @ and # have no mark and stay in the text. -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path x:Name="KindChipMark"
                                      Width="9" Height="9"
                                      IsVisible="False"
                                      Stretch="Uniform"
                                      Fill="#CCFFFFFF"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="KindChipText"
                                           FontSize="9.5"
                                           VerticalAlignment="Center"
                                           Foreground="#CCFFFFFF"/>
                            </StackPanel>
                        </Border>
                        <!-- A conversation the gateway's heartbeat wakes on a
                             timer. Its own chip beside the kind rather than a
                             word inside it, because it answers a different
                             question — the kind says who can read this, and this
                             says what keeps making it happen. See
                             OpenClawHeartbeat.

                             It beats here as well as on the orb, on the same
                             curve, because the panel is where you end up when
                             the orb's badge made you curious. -->
                        <Border x:Name="HeartChip"
                                IsVisible="False"
                                CornerRadius="4" Padding="4,1"
                                VerticalAlignment="Center"
                                Background="#26FFFFFF">
                            <!-- The heart is drawn (SymbolMarks.Heart, set
                                 in the constructor) for the same size reason as
                                 the orb's. The pair beats together, which is
                                 why the transform sits on this panel. -->
                            <StackPanel x:Name="HeartChipText"
                                        Orientation="Horizontal" Spacing="4">
                                <Path x:Name="HeartChipMark"
                                      Width="9" Height="9"
                                      Stretch="Uniform"
                                      Fill="#FFFF8797"
                                      VerticalAlignment="Center"/>
                                <TextBlock FontSize="9.5"
                                           Foreground="#FFFF8797"
                                           VerticalAlignment="Center"
                                           Text="heartbeat"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SubtitleText"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- The facts about this conversation that are true whether
                         or not anybody named it: which session, which folder,
                         which machine. Dimmer than the subtitle above it and
                         smaller than the title above that, because it is read
                         when you go looking rather than at a glance — a header
                         where all three lines shout is a header with no first
                         line.

                         **Two rows, and the machine has the second one to
                         itself.** The ticket asked for one, on the reasoning
                         that more rows would make the card taller than the
                         conversation under it — which turns out not to be true
                         here, and the measurement is the reason this is two:
                         the portrait beside these lines is 68 tall and the
                         three text rows come to about 53, so the second meta
                         row costs no header height whatsoever. What one row
                         did cost was the facts themselves. The panel opens 340
                         wide, which leaves this column about 180 for three
                         facts that want nearer 400, and every way of dividing
                         one row between them was tried and drawn: the whole
                         line trimmed threw the machine away, which is the fact
                         the design says is shown *always* and the only one
                         carrying a colour; reserving the machine on the right
                         left the rest reading "…"; wrapping to two lines broke
                         mid-path and ellipsised nothing. Given a row each,
                         both are legible at the width a panel actually opens
                         at.

                         A header with no lead at all — a room, which has no
                         directory — collapses the first row rather than
                         drawing it empty, so the machine sits directly under
                         the chips instead of after a blank line. ApplyMeta
                         does that; an empty TextBlock still measures a line
                         high, so leaving it visible would have been a gap
                         nobody asked for.

                         Two blocks rather than two runs in one, because the
                         machine wears the accent when the session is somewhere
                         else and a TextBlock has one Foreground. Background is
                         Transparent so the tooltip answers anywhere on either
                         row, including the space the ellipsis just made, which
                         is where somebody who cannot read the path will put
                         the pointer. The whole stack is collapsed until
                         Compose says there is something to say; see ApplyMeta. -->
                    <StackPanel x:Name="MetaRow"
                                IsVisible="False"
                                Background="Transparent">
                        <TextBlock x:Name="MetaText"
                                   FontSize="11"
                                   Foreground="#80FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MetaMachineText"
                                   IsVisible="False"
                                   FontSize="11"
                                   Foreground="#80FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Keep this chat open. First of the three because it is the
                     one that changes what the other two mean: pinned, the
                     close button closes for good rather than hiding, and the
                     header becomes a drag handle. Same 24x24 circle as its
                     neighbours — this is a row of toggles and the newcomer
                     should not announce itself as anything else. The fill is
                     what says whether the pin is on, so the ellipse is named
                     for the pin tests to read while Close's is not. -->
                <Grid x:Name="PinButton" Grid.Column="2" Width="24" Height="24"
                      VerticalAlignment="Center" Cursor="Hand"
                      ToolTip.Tip="Pin — keep this chat open">
                    <Ellipse x:Name="PinFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                    <TextBlock x:Name="PinGlyph" Text="&#128204;" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
                <!-- Global mute (CB-298): the output switch, beside the output
                     button it silences. Glyph, fill and tooltip are applied by
                     ApplyMuted from SymbolMarks.MuteLook / MuteTip; the tooltip
                     is set in code because it names whichever chord is
                     really bound. -->
                <Grid x:Name="MuteButton" Grid.Column="3" Width="24" Height="24"
                      VerticalAlignment="Center" Cursor="Hand">
                    <Ellipse x:Name="MuteFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                    <TextBlock x:Name="MuteGlyph" Text="&#128266;" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
                <Grid x:Name="SpeakButton" Grid.Column="4" Width="24" Height="24"
                      VerticalAlignment="Center" Cursor="Hand">
                    <Ellipse x:Name="SpeakFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                    <TextBlock x:Name="SpeakGlyph" Text="&#128264;" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <!-- The stop square while speech plays, drawn rather than
                         typed for the reason SymbolMarks gives. Shown instead of
                         SpeakGlyph, never with it; see SpeakLook. -->
                    <Path x:Name="SpeakStopMark" Width="8" Height="8"
                          IsVisible="False"
                          Stretch="Uniform" Fill="#F2FFFFFF"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"/>
                </Grid>
                <Grid x:Name="CloseButton" Grid.Column="5" Width="24" Height="24"
                      VerticalAlignment="Center" Cursor="Hand">
                    <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                    <TextBlock Text="&#10005;" FontSize="10" Foreground="#DDFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- Focusable="False" throughout: the input is the only focusable
                 thing in this window, so a wheel scroll or a stray click can
                 never pull focus out of it while a reply is streaming. That is
                 also what keeps the focus story a single point rather than a
                 scatter. -->
            <ScrollViewer x:Name="Scroll" Grid.Row="2"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Turns" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <!-- No x:DataType here: the items are ChatPanel's own
                             private nested TurnView class (ChatPanel.axaml.cs),
                             not a type this template can name from XAML.
                             Avalonia 12's default of compiled bindings would
                             otherwise refuse every {Binding} below at compile
                             time; x:CompileBindings="False" on the root Window
                             keeps this template on the older reflection-based
                             bindings instead. -->
                        <DataTemplate>
                            <!-- One template for all three roles, with the
                                 differences bound rather than templated per
                                 role: a message bubble and a system line differ
                                 in colour, alignment and corner shape, not in
                                 structure.

                                 CornerRadius is asymmetric on purpose — the
                                 corner nearest the speaker is squared off, which
                                 is what makes a stack of bubbles read as a
                                 conversation with two sides rather than as a
                                 list of rounded rectangles. -->
                            <Border Margin="{Binding Gap}" Padding="{Binding Pad}"
                                    CornerRadius="{Binding Corners}"
                                    MaxWidth="{Binding MaxBubbleWidth}"
                                    Background="{Binding Bubble}"
                                    HorizontalAlignment="{Binding Side}">
                                <StackPanel>
                                    <!-- Who said it, when that isn't one of the
                                         two ends of the conversation. In a
                                         channel the transcript carries the other
                                         agents in the room, and without this
                                         they arrive as anonymous grey bubbles
                                         that have to be worked out from context. -->
                                    <StackPanel Orientation="Horizontal"
                                                IsVisible="{Binding HasSpeaker}"
                                                Margin="0,0,0,3" Spacing="5">
                                        <!-- A shape the eye can recognise
                                             without reading it, which a column
                                             of similar names in similar hues
                                             is not. -->
                                        <Border Width="{Binding ChipSize}" Height="{Binding ChipSize}"
                                                CornerRadius="{Binding ChipCorners}"
                                                VerticalAlignment="Center"
                                                ClipToBounds="True"
                                                IsVisible="{Binding HasSpeakerAvatar}">
                                            <Image Source="{Binding SpeakerAvatar}"
                                                   Width="{Binding ChipSize}" Height="{Binding ChipSize}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <Border Width="{Binding ChipSize}" Height="{Binding ChipSize}"
                                                CornerRadius="{Binding ChipCorners}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasSpeakerInitials}"
                                                Background="{Binding SpeakerChip}">
                                            <TextBlock Text="{Binding SpeakerInitials}"
                                                       FontSize="{Binding ChipTextSize}" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding SpeakerChipInk}"/>
                                        </Border>
                                        <TextBlock Text="{Binding SpeakerName}"
                                                   IsVisible="{Binding ShowSpeakerName}"
                                                   FontSize="{Binding SpeakerNameSize}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding SpeakerInk}"/>
                                    </StackPanel>
                                    <!-- Built in code rather than bound to a
                                         string, because a reply is Markdown and
                                         drawing it as one TextBlock showed the
                                         asterisks and backticks. TurnView.Body
                                         is a small stack of paragraphs, lists
                                         and code blocks — see BuildBody. -->
                                    <ContentControl Content="{Binding Body}"
                                                    IsVisible="{Binding HasText}"/>
                                    <!-- A picture sent in the conversation.
                                         Width-constrained and free in height so
                                         a tall render keeps its proportions;
                                         the source arrives asynchronously, so
                                         the row simply has nothing in it until
                                         the bytes land. -->
                                    <Image Source="{Binding Image}"
                                           IsVisible="{Binding HasImage}"
                                           Width="228"
                                           Stretch="Uniform"
                                           Cursor="Hand"
                                           PointerPressed="Image_PointerPressed"
                                           HorizontalAlignment="Left"/>
                                    <!-- CB-272: a video the agent posted, as a
                                         tile rather than inline playback. Shown
                                         only once the gateway's meta answer says
                                         the clip is servable, sized to the
                                         clip's own aspect ratio; a click fetches
                                         the bytes and opens the system player.
                                         A refused or unreachable clip draws the
                                         note below instead, like a picture. -->
                                    <Border Classes="videoTile"
                                            IsVisible="{Binding HasVideo}"
                                            Width="{Binding VideoWidth}"
                                            Height="{Binding VideoHeight}"
                                            CornerRadius="8"
                                            Background="#CC1B1F27"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding ImageAlt}"
                                            PointerPressed="Video_PointerPressed"
                                            HorizontalAlignment="Left">
                                        <Panel>
                                            <Ellipse Width="44" Height="44"
                                                     Fill="#99000000"
                                                     Stroke="#E6FFFFFF" StrokeThickness="2"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <Path Data="M 0,0 L 0,20 L 17,10 Z"
                                                  Fill="#F2FFFFFF"
                                                  Margin="4,0,0,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                            <Border IsVisible="{Binding HasVideoDuration}"
                                                    Background="#B3000000"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="0,0,6,6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding VideoDuration}"
                                                           FontSize="{Binding TimeSize}"
                                                           Foreground="#F2FFFFFF"/>
                                            </Border>
                                        </Panel>
                                    </Border>
                                    <!-- CB-275: an audio note the agent posted, as a
                                         click-to-open tile, not an inline player: the
                                         system player is the player. A fixed 64 high,
                                         since audio has no aspect ratio. -->
                                    <Border Classes="audioTile"
                                            IsVisible="{Binding HasAudio}"
                                            Width="{Binding AudioWidth}"
                                            Height="64"
                                            CornerRadius="8"
                                            Background="#CC1B1F27"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding ImageAlt}"
                                            PointerPressed="Audio_PointerPressed"
                                            HorizontalAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                                            <Path Grid.Column="0"
                                                  Data="M 0,6 L 6,6 L 14,0 L 14,20 L 6,14 L 0,14 Z M 18,4 Q 23,10 18,16"
                                                  Fill="#F2FFFFFF" Stroke="#F2FFFFFF" StrokeThickness="1.5"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AudioLabel}"
                                                       Margin="12,0,8,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="#F2FFFFFF"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AudioDuration}"
                                                       IsVisible="{Binding HasAudioDuration}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{Binding TimeSize}"
                                                       Foreground="#F2FFFFFF"/>
                                        </Grid>
                                    </Border>
                                    <!-- CB-275: a file the agent posted, as a chip with
                                         its name and size. A click fetches it and hands
                                         it to the system's default app. -->
                                    <Border Classes="fileChip"
                                            IsVisible="{Binding HasDocument}"
                                            CornerRadius="8"
                                            Background="#CC1B1F27"
                                            Padding="10,8"
                                            MaxWidth="260"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding DocumentTip}"
                                            PointerPressed="Document_PointerPressed"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Data="M 0,0 L 10,0 L 14,4 L 14,18 L 0,18 Z M 10,0 L 10,4 L 14,4"
                                                  Stroke="#F2FFFFFF" StrokeThickness="1.5"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DocumentLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="170"
                                                       VerticalAlignment="Center"
                                                       Foreground="#F2FFFFFF"/>
                                            <TextBlock Text="{Binding DocumentSize}"
                                                       IsVisible="{Binding HasDocumentSize}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{Binding TimeSize}"
                                                       Foreground="#F2FFFFFF" Opacity="0.7"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- CB-93: why a picture that should have
                                         shown didn't, in the slot the picture
                                         would have occupied. The tooltip
                                         carries the path and the gateway's own
                                         code; the line itself stays one
                                         sentence so the bubble doesn't grow
                                         past what today's bare MEDIA: text
                                         already took. -->
                                    <TextBlock Text="{Binding ImageNote}"
                                               IsVisible="{Binding HasImageNote}"
                                               ToolTip.Tip="{Binding ImageNoteDetail}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               FontSize="{Binding TimeSize}" Opacity="0.6"
                                               Foreground="{Binding Ink}"/>
                                    <!-- Inside the bubble, trailing edge, the
                                         way a messaging app puts it. Hidden on
                                         system lines, which are notes about the
                                         conversation rather than part of it. -->
                                    <TextBlock Text="{Binding TimeText}"
                                               IsVisible="{Binding ShowTime}"
                                               HorizontalAlignment="Right"
                                               Margin="0,1,0,0"
                                               FontSize="{Binding TimeSize}" Opacity="0.5"
                                               Foreground="{Binding Ink}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The wait, while it is happening.

                 A row of its own rather than an overlay. Overlaying was tried
                 first and is wrong: a Grid cell stacks its children, so the
                 indicator sat on top of the very note explaining the wait and
                 both became unreadable. Collapsed (IsVisible=False) the row has
                 no height, so it costs nothing when there is no fetch, and the
                 one reflow when it appears is the honest cost of showing it.

                 Indeterminate on purpose. A window that fits one chunk is a
                 single round trip with no intermediate signal, so a percentage
                 would be invented — and an invented one parks at 99% and makes
                 a healthy transfer look stuck. Elapsed time is the honest
                 number, and the hint underneath is what stops three minutes
                 reading as a fault. See CB-58. -->
            <Border x:Name="FetchWaitBox" Grid.Row="1" IsVisible="False"
                    Padding="10,7" CornerRadius="8"
                    Background="#FF2C2C31"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="FetchWaitText" TextWrapping="Wrap"
                               FontSize="11" Foreground="#EEFFFFFF" />
                    <TextBlock x:Name="FetchWaitHint" TextWrapping="Wrap"
                               FontSize="10" Foreground="#99FFFFFF" />
                    <ProgressBar x:Name="FetchWaitBar" IsIndeterminate="True"
                                 Height="3" MinWidth="0" />
                </StackPanel>
            </Border>

            <!-- A dialog the session has stopped on, almost always a permission
                 prompt. It sits between the transcript and the input because
                 that is what it is: the thing standing between what has been
                 said and saying anything else.

                 Amber, matching "preparing" on the speak button and the arrange
                 button's active state, so the app keeps one vocabulary for
                 "waiting on something" rather than acquiring a second.

                 The options are not ours. Their labels are read off the pane by
                 ClaudeCodeChatSession.ParsePrompt, because the dialog is drawn
                 by the TUI and never reaches the transcript — and a button that
                 said "Approve" while sending a digit that meant something else
                 is the one failure this feature must not have. When the screen
                 can't be parsed there are no options and only the terminal
                 button, which is the honest answer at that point. -->
            <Border x:Name="PromptBox" Grid.Row="3" IsVisible="False"
                    CornerRadius="8" Padding="8,6"
                    Background="#26B8860B" BorderBrush="#80B8860B" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PromptTitle" TextWrapping="Wrap"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF"/>
                    <ItemsControl x:Name="PromptOptions">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#33FFFFFF"
                                        BorderBrush="#40FFFFFF" BorderThickness="1"
                                        CornerRadius="6" Padding="7,4" Cursor="Hand"
                                        PointerPressed="PromptOption_PointerPressed">
                                    <!-- No FontSize of its own: it inherits
                                         PromptOptions', which ApplyTextScale
                                         sets. A template has no handle a
                                         resize can reach, and the option's own
                                         view model belongs to the parser
                                         rather than to this window. -->
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                               Foreground="#EEFFFFFF"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Always offered, not only as a fall back: the dialog's
                         last option is usually "no, and tell Claude what to do
                         differently", which needs a sentence typed rather than
                         a button pressed. -->
                    <TextBlock x:Name="PromptElsewhere"
                               Text="Answer in the terminal"
                               FontSize="10.5" Cursor="Hand"
                               TextDecorations="Underline"
                               Foreground="#B3FFFFFF"
                               PointerPressed="PromptElsewhere_PointerPressed"/>
                </StackPanel>
            </Border>

            <!-- Slash-command suggestions, shown while the input's first word
                 is still being typed and starts with "/". Lives in the layout
                 rather than a floating Popup: Reposition() already flips the
                 window above or below the orb to stay on screen, so this
                 borrows machinery that is already there rather than teaching a
                 second control the same trick. -->
            <Border x:Name="SlashBox" Grid.Row="4" IsVisible="False"
                    CornerRadius="8" Padding="4"
                    Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                <ScrollViewer MaxHeight="150" Focusable="False"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SlashList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowFill}"
                                        CornerRadius="5" Padding="7,4" Cursor="Hand"
                                        PointerPressed="SlashSuggestion_PointerPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F2FFFFFF"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10"
                                                   Foreground="#99FFFFFF"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="5" Spacing="6">
                <!-- CB-267: a session running without permission prompts holds
                     every message this panel delivers to it until someone
                     approves it there, and the socket accepts the bytes either
                     way. So before anything is sent, the panel says so and offers
                     the one-line settings change that lets them straight in —
                     armed two-step, like the orb's own confirmations, because it
                     changes what *every* session on the machine accepts. Styled
                     as FetchWaitBox is: a note about the conversation, not a
                     dialog the session is stopped on (that one is amber).
                     Above the pictures and the box, so it is read before typing.
                     Shown and filled by ApplyInbound. -->
                <Border x:Name="InboundBox" IsVisible="False"
                        Padding="10,7" CornerRadius="8"
                        Background="#FF2C2C31"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="InboundText" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#EEFFFFFF"/>
                        <TextBlock x:Name="InboundPath" TextWrapping="Wrap"
                                   FontSize="10" Foreground="#99FFFFFF"/>
                        <WrapPanel x:Name="InboundButtons" Orientation="Horizontal">
                            <Border x:Name="InboundAskButton" Margin="0,0,6,0"
                                    Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    CornerRadius="6" Padding="7,4" Cursor="Hand">
                                <TextBlock x:Name="InboundAskLabel" FontSize="11" Foreground="#EEFFFFFF"/>
                            </Border>
                            <Border x:Name="InboundConfirmButton" Margin="0,0,6,0"
                                    Background="#4DB8860B" BorderBrush="#80B8860B" BorderThickness="1"
                                    CornerRadius="6" Padding="7,4" Cursor="Hand">
                                <TextBlock x:Name="InboundConfirmLabel" FontSize="11" Foreground="#F2FFFFFF"/>
                            </Border>
                            <Border x:Name="InboundCancelButton" Margin="0,0,6,0"
                                    Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    CornerRadius="6" Padding="7,4" Cursor="Hand">
                                <TextBlock x:Name="InboundCancelLabel" FontSize="11" Foreground="#EEFFFFFF"/>
                            </Border>
                            <Border x:Name="InboundResendButton" Margin="0,0,6,0"
                                    Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    CornerRadius="6" Padding="7,4" Cursor="Hand">
                                <TextBlock x:Name="InboundResendLabel" FontSize="11" Foreground="#EEFFFFFF"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Pictures pasted since the last send, waiting to go out
                     with whatever gets typed next. Hidden rather than
                     collapsed-to-nothing by an empty items source, so
                     showing it is one flag rather than a size recompute on
                     every paste. -->
                <ItemsControl x:Name="Attachments" IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The remove button sits over the corner of the
                                 thumbnail rather than beside it: a row of
                                 several pastes is already tight at 40pt each,
                                 and a full second control per thumbnail would
                                 double the row's width for no picture worth
                                 more of it. -->
                            <Grid Width="40" Height="40">
                                <Border CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Width="40" Height="40"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <Grid Width="16" Height="16"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-4,-4,0" Cursor="Hand"
                                      PointerPressed="Attachment_Remove_PointerPressed">
                                    <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1"/>
                                    <TextBlock Text="&#10005;" FontSize="8" Foreground="#DDFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Said in place of the box, for a session that can be read
                     and not written to. Hidden by default, and swapped for the
                     row below by ApplyComposerAffordances — at bind, and again
                     whenever the session raises ReadOnlyChanged.
                     A Claude Desktop chat uses this box too (CB-266): it is
                     read-only until the chat is on Remote Control, and can flip
                     back.

                     A sentence rather than a disabled TextBox, which is the
                     opposite of what IRemoteChatComposer argues for elsewhere in
                     this panel. A disabled box still says "this is where you
                     reply, later"; a cloud session that has ended, been deleted
                     or refused this login will not take a reply later either,
                     so the honest thing is to say so and where the conversation
                     can still be opened. A live cloud session is written to
                     through POST /v1/code/sessions/{id}/events (measured
                     2026-09-28) and keeps the ordinary composer. See
                     IRemoteChatReadOnly. -->
                <!-- A Grid rather than a horizontal StackPanel: a StackPanel
                     measures its children with infinite width, so the note
                     never wrapped and a reason longer than the panel pushed the
                     link off its right edge (seen in chat-panel-cloud-ended.png,
                     CB-199). The star column gives the sentence a width to wrap
                     at, and the link keeps what it needs. -->
                <Grid x:Name="ReadOnlyBox"
                      IsVisible="False"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="6"
                      Margin="2,2,2,4">
                    <TextBlock x:Name="ReadOnlyNote" Grid.Column="0"
                               FontSize="11"
                               Opacity="0.7"
                               Foreground="#EEFFFFFF"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <!-- The way to the place it *can* be replied to, as a link
                         rather than an address spelled out in the sentence
                         beside it. An orb click goes to the session; so does
                         this. The blue and the hover underline are the same ones
                         the settings window's own links wear — one link look for
                         the app, not a second answer to a question already
                         settled. -->
                    <TextBlock x:Name="ReadOnlyLink" Grid.Column="1"
                               IsVisible="False"
                               FontSize="11"
                               Foreground="#4A90D9"
                               Cursor="Hand"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- The same way to the session for one that is *live*, which
                     is the case ReadOnlyLink above cannot cover: it lives in
                     the read-only box, and CB-199 made a live cloud session
                     keep its composer, so the box (and the link with it) is
                     hidden exactly while the conversation is happening. Shown
                     only while the composer is, so there is one link on screen
                     at a time — this one over a box that takes a reply, the
                     read-only box's own over one that does not. Same blue and
                     same hover underline as ReadOnlyLink. -->
                <TextBlock x:Name="SessionLink"
                           IsVisible="False"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="#4A90D9"
                           Cursor="Hand"
                           Margin="2,0,2,2"/>

                <Grid x:Name="ComposerRow" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <!-- AcceptsReturn so the TextBox owns newline insertion,
                         caret placement and undo; Enter-to-send is
                         intercepted on the tunnel route instead, and so is a
                         paste that turns out to be a picture — see
                         OnInputKeyDown. Grows to about three lines, then
                         scrolls inside itself. -->
                    <TextBox x:Name="Input" Grid.Column="0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="66" MinHeight="26" FontSize="11.5"
                             Watermark="Message…"
                             Background="#33FFFFFF" Foreground="#EEFFFFFF"
                             CaretBrush="#EEFFFFFF"
                             BorderBrush="#40FFFFFF" BorderThickness="1"
                             CornerRadius="6" Padding="6,3"/>
                    <!-- For a session there is nowhere to type into: a
                         background job, run by a daemon precisely so that no
                         terminal has to hold it. Clicking it opens (or brings
                         forward) the `claude agents` roster, which is the same
                         place a click on the orb goes — see
                         ClickRouting.AttachWouldReach, which decides whether this
                         is shown at all.

                         The gear matches the badge that orb wears, so the two
                         read as the same fact rather than as two unrelated
                         marks. First in the row because it is what you would do
                         *before* typing, and hidden for every session that can
                         be typed into as it is. -->
                    <Grid x:Name="AttachButton" Grid.Column="1" Width="24" Height="24"
                          IsVisible="False" Cursor="Hand"
                          ToolTip.Tip="Open the agents view">
                        <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                        <!-- Drawn, not typed: SymbolMarks.Gear, set in the
                             constructor. U+2699 is a colour emoji on Windows. -->
                        <Path x:Name="AttachMark" Width="11" Height="11"
                              Stretch="Uniform" Fill="#DDFFFFFF"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                    </Grid>
                    <Grid x:Name="MicButton" Grid.Column="2" Width="24" Height="24"
                          IsVisible="False" Cursor="Hand">
                        <Ellipse x:Name="MicFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                        <TextBlock Text="&#127908;" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Grid x:Name="SendButton" Grid.Column="3" Width="24" Height="24" Cursor="Hand">
                        <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                        <TextBlock Text="&#10148;" FontSize="11" Foreground="#DDFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Stops the reply in flight, for a session that can say
                         one is running and that this app can actually stop
                         (IRemoteChatInterrupt — today only a cloud session).
                         Hidden rather than disabled whenever there is nothing to
                         stop, per CB-59: a greyed Stop over an idle session reads
                         as "stuck". Inside ComposerRow so it goes with the row
                         when the session turns read-only, and after Send because
                         it is the thing you reach for once you have sent.

                         A filled square, the glyph every media control uses for
                         stop, in the same ring as its neighbours so the row
                         reads as one set of controls. -->
                    <Grid x:Name="StopButton" Grid.Column="4" Width="24" Height="24"
                          IsVisible="False" Cursor="Hand"
                          ToolTip.Tip="Stop"
                          AutomationProperties.Name="Stop">
                        <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                        <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1"
                                   Fill="#DDFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>

        <!-- Edges first, corners last, so the corners win the few pixels of
             overlap at each end of an edge strip — a diagonal drag should never
             be swallowed by the straight edge next to it. Margins on the edge
             strips leave that corner territory to the corner strips rather than
             fighting them for it. -->
        <Rectangle x:Name="ResizeN" Height="6" Margin="10,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNorthSouth"/>
        <Rectangle x:Name="ResizeS" Height="6" Margin="10,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNorthSouth"/>
        <Rectangle x:Name="ResizeW" Width="6" Margin="0,10"
                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWestEast"/>
        <Rectangle x:Name="ResizeE" Width="6" Margin="0,10"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWestEast"/>
        <!-- No Cursor set here: StandardCursorType has no diagonal resize
             member that Avalonia.Native's macOS backend actually draws (see
             the long comment beside NwSeCursor in the code-behind).
             TopLeftCorner fell through to a plain crosshair there, and Hand
             didn't read as "resize" either, so these four get a hand-drawn
             cursor bitmap assigned in the constructor instead. -->
        <Rectangle x:Name="ResizeNW" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Fill="Transparent"/>
        <Rectangle x:Name="ResizeNE" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Fill="Transparent"/>
        <Rectangle x:Name="ResizeSW" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Fill="Transparent"/>
        <Rectangle x:Name="ResizeSE" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Fill="Transparent"/>
    </Grid>
</Window>
