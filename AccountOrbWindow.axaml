<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Orbweaver.AccountOrbWindow"
        Width="72" Height="72"
        SizeToContent="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- A ring in the danger band breathes, but not from here any more.

         Until CB-219 this was a `Path.breathing` style animation with
         IterationCount="Infinite", declared here because Avalonia refuses to *run*
         a looping animation from code (RunAsync answers "Looping animations must
         not use the Run method."; the first version called it anyway and left
         twenty-two unobserved task exceptions in the crash log). That part was
         right. What it cost was not: an infinite animation keeps the compositor
         rendering on every vsync for as long as it runs, and a ring in the danger
         band runs it all the time. Measured on a MacBook, Buddy used 34.8% CPU
         with the rings breathing against 9.5% with them held still.

         So the breath is now stepped by a shared ticker in AccountOrbWindow.axaml.cs
         at 20 frames a second, sampling the same curve (UsageRingBreath: 1.0 to
         0.55 and back, a sine ease, 2.6 s each way). The `breathing` class still
         marks which rings breathe; it just selects nothing here. 0.55 rather than
         0 at the far end, as before, because a ring that vanishes is a ring you
         cannot read the sweep of, and the sweep is the number. -->

    <!-- One account's usage, as an orb wearing three rings.

         Bigger than OrbWindow's 56 and centred at (36,36) rather than (28,28),
         which is safe here and would not be there: the session orb's centre is
         hardcoded in TeamLinks and ChatPanel, which reach for it by name, while
         nothing reaches for an account orb. Three concentric rings plus two
         legible letters do not fit in 36 device-independent pixels, and the
         letters are what tell two accounts apart.

         Root is pinned to 72x72 at the top left for the same reason OrbWindow's
         is pinned to 56: Windows floors a top-level window at
         SM_CXMINTRACK/SM_CYMINTRACK, so the window is wider than this on that
         platform and the surplus is transparent slack to the right. Window size
         can never be a layout input here.

         The rings themselves are drawn in code — see AccountOrbWindow.axaml.cs —
         because their sweep is the data. This is the first arc drawing in the
         app; the arithmetic lives in UsageRingGeometry so it can be tested
         without any of this. -->
    <Canvas x:Name="Root"
            Width="72" Height="72"
            Background="Transparent"
            Cursor="Hand"
            HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- CB-287. Account orbs had no right-click menu at all; this is the
             first item. It raises CustomizeRequested and leaves what to open to
             AccountOrbs, so the window stays ignorant of the editor. -->
        <Canvas.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CustomizeItem" Header="Customize…" Click="Customize_Click"/>
            </ContextMenu>
        </Canvas.ContextMenu>

        <!-- The unfilled part of each ring, so a ring at 3% still reads as a
             ring rather than as a stray tick floating above an orb. -->
        <Ellipse x:Name="WeeklyTrack" Canvas.Left="4" Canvas.Top="4"
                 Width="64" Height="64"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>
        <Ellipse x:Name="SessionTrack" Canvas.Left="11" Canvas.Top="11"
                 Width="50" Height="50"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>

        <!-- The inner ring is a track only when there is something to track.
             An account with extra usage switched off has no cap to be a
             fraction of, and gets the dotted absence set up in code instead. -->
        <Ellipse x:Name="ExtraTrack" Canvas.Left="18" Canvas.Top="18"
                 Width="36" Height="36"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>

        <Path x:Name="WeeklyArc" StrokeThickness="5" StrokeLineCap="Round"/>
        <Path x:Name="SessionArc" StrokeThickness="5" StrokeLineCap="Round"/>
        <Path x:Name="ExtraArc" StrokeThickness="5" StrokeLineCap="Round"/>

        <!-- The disc is split in two so a picked icon (CB-287) can sit between
             the fill and the rim: fill, then picture, then rim, then letters.
             The picture is clipped to a circle just inside the rim and the
             disc itself is 28 wide, so it never reaches the innermost ring,
             whose stroke starts at r=15.5. Nothing is drawn over an icon but
             the rim, which is why no scrim is needed and why the rings read
             exactly as they do without one. -->
        <Ellipse x:Name="DiscFill" Canvas.Left="22" Canvas.Top="22"
                 Width="28" Height="28"
                 Fill="#F51C1C1E"/>

        <Image x:Name="Icon" Canvas.Left="22" Canvas.Top="22"
               Width="28" Height="28"
               Stretch="UniformToFill"
               IsVisible="False"
               IsHitTestVisible="False">
            <Image.Clip>
                <EllipseGeometry Center="14,14" RadiusX="13.25" RadiusY="13.25"/>
            </Image.Clip>
        </Image>

        <Ellipse x:Name="DiscRim" Canvas.Left="22" Canvas.Top="22"
                 Width="28" Height="28"
                 Stroke="#B8FFFFFF" StrokeThickness="1.5"
                 IsHitTestVisible="False"/>

        <TextBlock x:Name="Glyph"
                   Canvas.Left="22" Canvas.Top="22"
                   Width="28" Height="28"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Foreground="#F2FFFFFF"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="5"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Which CLI this account is. Bottom-left of the 72 window, on the
             weekly ring rather than on the 28px disc — a 22px mark on that
             disc would cover the letters it is supposed to sit beside. Same
             size as the session orb's mark so a mixed row reads as Claude /
             Codex / Grok from across the desk. -->
        <Border x:Name="CliBadge"
                Canvas.Left="2" Canvas.Top="48"
                Width="22" Height="22"
                CornerRadius="11"
                IsVisible="False"
                BorderBrush="#73FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Path x:Name="CliGlyph"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  Fill="#F2FFFFFF"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
        </Border>

        <!-- Shown while this account's card is pinned. Top-right, which is free
             here: the session orb's four badge corners are all spoken for, but
             an account orb has no kind, no heartbeat and no presence to show. -->
        <Border x:Name="PinBadge"
                Canvas.Left="52" Canvas.Top="2"
                Width="18" Height="18"
                CornerRadius="9"
                IsVisible="False"
                Background="#F51C1C1E"
                BorderBrush="#66FFFFFF"
                BorderThickness="1">
            <TextBlock Text="&#128204;"
                       FontSize="9"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Border>
    </Canvas>
</Window>
